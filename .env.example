# Copier en .env sur le serveur (jamais commité) et remplir.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=comptafiscaventisax.pythonanywhere.com
# Dossier des sauvegardes quotidiennes de la base (vide = désactivé).
DJANGO_BACKUP_DIR=/home/comptafiscaventisax/backups
# En-tête portant l'IP réelle derrière le proxy PythonAnywhere (limite d'inscriptions par IP).
DJANGO_SIGNUP_IP_HEADER=HTTP_X_REAL_IP
# E-mail sortant (vérification d'inscription, mot de passe oublié) : Gmail SMTP + mot de passe d'application.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
